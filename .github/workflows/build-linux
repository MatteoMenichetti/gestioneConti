name: Build & Release

# ─── TRIGGER ────────────────────────────────────────────────────────────────
# • Push di un tag vX.Y.Z  → build + GitHub Release con binari allegati
# • workflow_dispatch       → build manuale senza release (utile per test)
on:
  push:
    tags:
      - "v*.*.*"
  workflow_dispatch:

# ─── PERMESSI ───────────────────────────────────────────────────────────────
# "contents: write" è necessario per creare la GitHub Release e caricare gli asset
permissions:
  contents: write

# ─── JOBS ───────────────────────────────────────────────────────────────────
jobs:

  # ══════════════════════════════════════════════════════════════════════════
  # JOB 1 – BUILD
  # Strategia a matrice: compila in parallelo per ogni combinazione OS / RID.
  # ══════════════════════════════════════════════════════════════════════════
  build:
    name: Build [${{ matrix.rid }}]

    strategy:
      fail-fast: false          # Se un target fallisce, gli altri continuano
      matrix:
        include:

          # Linux x64 ─────────────────────────────────────────────────────
          - os: ubuntu-latest
            rid: linux-x64
            artifact_name: app-linux-x64
            binary_ext: ""       # Nessuna estensione su Linux

          # macOS Intel ────────────────────────────────────────────────────
          - os: macos-latest
            rid: osx-x64
            artifact_name: app-osx-x64
            binary_ext: ""

          # macOS Apple Silicon ─────────────────────────────────────────────
          # NOTA: osx-arm64 richiede un runner macOS; non si cross-compila
          # in modo affidabile da Linux a causa dei binding nativi di Avalonia.
          - os: macos-latest
            rid: osx-arm64
            artifact_name: app-osx-arm64
            binary_ext: ""

    runs-on: ${{ matrix.os }}

    steps:

      # 1. Checkout del codice sorgente (incluse le submodule se presenti)
      - name: Checkout repository
        uses: actions/checkout@v4
        with:
          submodules: recursive

      # 2. Installa la versione di .NET specificata
      #    ⚠️  Cambia "9.0.x" con la versione del tuo global.json o .csproj
      - name: Setup .NET SDK
        uses: actions/setup-dotnet@v4
        with:
          dotnet-version: "9.0.x"

      # 3. Cache dei pacchetti NuGet → risparmia 1-3 minuti per run
      - name: Cache NuGet packages
        uses: actions/cache@v4
        with:
          path: ~/.nuget/packages
          # La chiave cambia solo se cambia il lock-file dei pacchetti
          key: nuget-${{ matrix.rid }}-${{ hashFiles('**/*.csproj', '**/packages.lock.json') }}
          restore-keys: |
            nuget-${{ matrix.rid }}-
            nuget-

      # 4. Ripristino delle dipendenze
      - name: Restore dependencies
        run: dotnet restore
        # ⚠️  Se la tua solution/.sln non è nella root, specifica il percorso:
        # run: dotnet restore src/MyApp.sln

      # 5. Esegui i test (rimuovi questo step se non hai test automatici)
      - name: Run tests
        run: dotnet test --no-restore --configuration Release --verbosity minimal
        # ⚠️  Se i test dell'UI richiedono un display (es. Avalonia headless):
        # run: xvfb-run dotnet test ...   # solo su Linux

      # 6. Pubblica l'eseguibile self-contained come file singolo
      #
      #    Opzioni chiave:
      #      --self-contained true      → include il runtime .NET nel binario
      #      -p:PublishSingleFile=true  → un unico file eseguibile
      #      -p:EnableCompressionInSingleFile=true → riduce le dimensioni (~30%)
      #      -p:IncludeNativeLibrariesForSelfExtract=true → embedding lib native
      #      -p:StripSymbols=true       → rimuove i simboli di debug su Linux/macOS
      #
      #    ⚠️  Sostituisci "src/MyApp/MyApp.csproj" con il percorso del tuo progetto principale
      - name: Publish single-file executable
        run: |
          dotnet publish src/MyApp/MyApp.csproj \
            --configuration Release \
            --runtime ${{ matrix.rid }} \
            --self-contained true \
            -p:PublishSingleFile=true \
            -p:EnableCompressionInSingleFile=true \
            -p:IncludeNativeLibrariesForSelfExtract=true \
            -p:StripSymbols=true \
            --output ./dist/${{ matrix.rid }}

      # 7. Rendi eseguibile il binario (necessario su Linux/macOS dopo publish)
      - name: Set executable permission
        run: |
          # ⚠️  Sostituisci "MyApp" con il nome del tuo eseguibile (= AssemblyName nel .csproj)
          chmod +x ./dist/${{ matrix.rid }}/MyApp${{ matrix.binary_ext }}

      # 8. Crea uno zip dell'artefatto per upload e allegato alla release
      - name: Package artifact (zip)
        run: |
          cd ./dist/${{ matrix.rid }}
          zip -r ../../${{ matrix.artifact_name }}.zip .

      # 9. Carica l'artifact per il job successivo (release) e per download diretto
      - name: Upload build artifact
        uses: actions/upload-artifact@v4
        with:
          name: ${{ matrix.artifact_name }}
          path: ${{ matrix.artifact_name }}.zip
          retention-days: 7        # Conserva per 7 giorni (gratis su GitHub)
          if-no-files-found: error


  # ══════════════════════════════════════════════════════════════════════════
  # JOB 2 – RELEASE
  # Gira solo su push di tag (non su workflow_dispatch).
  # Aspetta che tutti i build completino, poi crea la GitHub Release
  # e vi allega gli zip prodotti dalla matrice.
  # ══════════════════════════════════════════════════════════════════════════
  release:
    name: Create GitHub Release
    needs: build
    runs-on: ubuntu-latest

    # Esegui questo job SOLO quando il trigger è un tag push
    if: startsWith(github.ref, 'refs/tags/')

    steps:

      # Scarica tutti gli artifact prodotti dal job "build"
      - name: Download all artifacts
        uses: actions/download-artifact@v4
        with:
          path: ./artifacts    # Ogni artifact è in una sottocartella con il suo nome

      # Debug: mostra i file scaricati (rimuovibile in produzione)
      - name: List downloaded artifacts
        run: find ./artifacts -type f | sort

      # Crea la release e allega i binari in un unico step
      - name: Create GitHub Release and upload assets
        uses: softprops/action-gh-release@v2
        with:
          # Nome della release (es. "Release v1.2.3")
          name: "Release ${{ github.ref_name }}"

          # Il corpo del changelog: puoi sostituirlo con il contenuto di CHANGELOG.md
          # usando: body_path: CHANGELOG.md
          body: |
            ## 🚀 Release ${{ github.ref_name }}

            ### Download
            | Piattaforma        | File                          |
            |--------------------|-------------------------------|
            | Linux x64          | `app-linux-x64.zip`           |
            | macOS Intel (x64)  | `app-osx-x64.zip`             |
            | macOS Apple Silicon| `app-osx-arm64.zip`           |

            ### Note
            Gli eseguibili sono **self-contained**: non richiedono l'installazione del runtime .NET.
            Su macOS potrebbe essere necessario rimuovere la quarantena:
            ```bash
            xattr -d com.apple.quarantine ./MyApp
            ```

          # Se il tag non esiste ancora come release, la crea; altrimenti aggiorna
          draft: false
          prerelease: ${{ contains(github.ref_name, '-rc') || contains(github.ref_name, '-beta') || contains(github.ref_name, '-alpha') }}

          # Allega tutti gli zip trovati nelle sottocartelle degli artifact
          files: |
            artifacts/app-linux-x64/app-linux-x64.zip
            artifacts/app-osx-x64/app-osx-x64.zip
            artifacts/app-osx-arm64/app-osx-arm64.zip

          # Il token viene iniettato automaticamente da GitHub Actions
          token: ${{ secrets.GITHUB_TOKEN }}
