<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CostsManager.ViewModels"
        x:Class="CostsManager.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Rent Manager"
        Width="540" Height="880"
        MinWidth="420" MinHeight="700"
        CanResize="True"
        WindowStartupLocation="CenterScreen"
        TransparencyLevelHint="AcrylicBlur"
        Background="Transparent"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        SystemDecorations="None">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <!-- Root: deep frosted background with mesh gradient -->
    <Grid>

        <!-- Animated gradient background -->
        <Border>
            <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#FF0A0F1E" Offset="0"/>
                    <GradientStop Color="#FF0D1B3E" Offset="0.4"/>
                    <GradientStop Color="#FF0F1830" Offset="0.7"/>
                    <GradientStop Color="#FF060C1A" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- Decorative blurred orbs -->
        <Canvas ClipToBounds="True">
            <!-- Cyan orb top-right -->
            <Ellipse Canvas.Right="-60" Canvas.Top="-60"
                     Width="280" Height="280"
                     Opacity="0.18">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#FF00C4F4" Offset="0"/>
                        <GradientStop Color="#0000C4F4" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <!-- Green orb bottom-left -->
            <Ellipse Canvas.Left="-80" Canvas.Bottom="-80"
                     Width="320" Height="320"
                     Opacity="0.14">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#FF00D67E" Offset="0"/>
                        <GradientStop Color="#0000D67E" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <!-- Orange orb center-right -->
            <Ellipse Canvas.Right="30" Canvas.Bottom="160"
                     Width="180" Height="180"
                     Opacity="0.10">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#FFFF9500" Offset="0"/>
                        <GradientStop Color="#00FF9500" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Canvas>

        <!-- Main content -->
        <DockPanel Margin="0">

            <!-- Custom title bar -->
            <Border DockPanel.Dock="Top"
                    Background="#14FFFFFF"
                    BorderBrush="#22FFFFFF"
                    BorderThickness="0,0,0,1"
                    Height="48"
                    PointerPressed="TitleBar_PointerPressed">
                <Grid ColumnDefinitions="Auto,*,Auto" Margin="16,0">
                    <!-- Traffic lights -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8"
                                VerticalAlignment="Center">
                        <Button Classes="glass-btn" Width="13" Height="13"
                                CornerRadius="99" Padding="0"
                                Background="#FFFF5F57" BorderBrush="Transparent"
                                Click="BtnClose_Click"/>
                        <Button Width="13" Height="13"
                                CornerRadius="99" Padding="0"
                                Background="#FFFF9F0A" BorderBrush="Transparent"
                                Click="BtnMinimize_Click"/>
                        <Ellipse Width="13" Height="13" Fill="#5528CA41"/>
                    </StackPanel>
                    <!-- Title -->
                    <TextBlock Grid.Column="1"
                               Text="Gestore Foglio di Calcolo"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="#CCFFFFFF"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                    <!-- Path hint -->
                    <TextBlock Grid.Column="2"
                               Text="{Binding FilePath, FallbackValue='Nessun file'}"
                               FontSize="11"
                               Foreground="#55FFFFFF"
                               VerticalAlignment="Center"
                               MaxWidth="180"
                               TextTrimming="CharacterEllipsis"/>
                </Grid>
            </Border>

            <!-- Scrollable body -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,20,28,68">
                <StackPanel Spacing="20">

                    <!-- ① FILE SECTION ────────────────────────── -->
                    <Border Classes="glass-card">
                        <StackPanel Spacing="14">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="📂" FontSize="20" VerticalAlignment="Center"/>
                                <TextBlock Text="File Excel"
                                           FontSize="16" FontWeight="Bold"
                                           Foreground="#EEFFFFFF"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                <TextBox Grid.Column="0" Grid.Row="0"
                                         Classes="glass-input"
                                         Watermark="Percorso file .xlsx…"
                                         Text="{Binding FilePath}"
                                         IsReadOnly="True"/>
                                <Button Grid.Column="1" Grid.Row="0"
                                        Classes="glass-btn"
                                        Content="Sfoglia"
                                        Margin="8,0,0,0"
                                        Command="{Binding BrowseFileCommand}"/>
                                <TextBlock Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2"
                                           Classes="status-info"
                                           Text="{Binding FileStatusMessage}"
                                           IsVisible="{Binding HasFileStatus}"
                                           Margin="0,6,0,0"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ② AGGIUNGI FOGLIO ANNO ───────────────── -->
                    <Border Classes="glass-card">
                        <StackPanel Spacing="16">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="📅" FontSize="20" VerticalAlignment="Center"/>
                                <TextBlock Text="Aggiungi Foglio Anno"
                                           FontSize="16" FontWeight="Bold"
                                           Foreground="#EEFFFFFF"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock Text="Inserisci l'anno per creare un nuovo foglio."
                                       FontSize="12" Foreground="#88FFFFFF"
                                       TextWrapping="Wrap"/>

                            <StackPanel Spacing="10">
                                <TextBox Classes="glass-input"
                                         Watermark="Es. 2025"
                                         Text="{Binding YearInput}"
                                         MaxLength="4"
                                         KeyDown="YearInput_KeyDown"/>
                                <Button Classes="glass-btn-accent"
                                        HorizontalAlignment="Right"
                                        Content="✓  Conferma"
                                        MinWidth="140"
                                        Command="{Binding AddYearSheetCommand}"
                                        IsEnabled="{Binding IsFileLoaded}"/>
                            </StackPanel>

                            <TextBlock Classes="status-ok"
                                       Text="{Binding YearStatusMessage}"
                                       IsVisible="{Binding HasYearStatus}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- ③ AGGIORNA FORMULE AFFITTO ───────────── -->
                    <Border Classes="glass-card">
                        <StackPanel Spacing="16">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="🏠" FontSize="20" VerticalAlignment="Center"/>
                                <TextBlock Text="Formule Affitto"
                                           FontSize="16" FontWeight="Bold"
                                           Foreground="#EEFFFFFF"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock Text="Ricalcola e aggiorna tutte le formule relative all'affitto nel foglio attivo."
                                       FontSize="12" Foreground="#88FFFFFF"
                                       TextWrapping="Wrap"/>

                            <Button Classes="glass-btn-success"
                                    HorizontalAlignment="Stretch"
                                    Content="↺  Aggiorna Formule Affitto"
                                    Command="{Binding UpdateRentFormulasCommand}"
                                    IsEnabled="{Binding IsFileLoaded}"/>

                            <TextBlock Classes="status-ok"
                                       Text="{Binding RentStatusMessage}"
                                       IsVisible="{Binding HasRentStatus}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- ④ AGGIORNA FORMULE TELEFONO ──────────── -->
                    <Border Classes="glass-card">
                        <StackPanel Spacing="16">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="📱" FontSize="20" VerticalAlignment="Center"/>
                                <TextBlock Text="Formule Telefono"
                                           FontSize="16" FontWeight="Bold"
                                           Foreground="#EEFFFFFF"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock Text="Ricalcola e aggiorna tutte le formule relative al telefono nel foglio attivo."
                                       FontSize="12" Foreground="#88FFFFFF"
                                       TextWrapping="Wrap"/>

                            <Button Classes="glass-btn-warn"
                                    HorizontalAlignment="Stretch"
                                    Content="↺  Aggiorna Formule Telefono"
                                    Command="{Binding UpdatePhoneFormulasCommand}"
                                    IsEnabled="{Binding IsFileLoaded}"/>

                            <TextBlock Classes="status-ok"
                                       Text="{Binding PhoneStatusMessage}"
                                       IsVisible="{Binding HasPhoneStatus}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- ⑤ STATUS GLOBALE ─────────────────────── -->
                    <Border Classes="glass-card"
                            IsVisible="{Binding HasGlobalStatus}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Log"
                                       FontSize="12" FontWeight="Bold"
                                       Foreground="#66FFFFFF"/>
                            <ItemsControl ItemsSource="{Binding LogMessages}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}"
                                                   FontSize="11"
                                                   Foreground="#99FFFFFF"
                                                   TextWrapping="Wrap"
                                                   Margin="0,1"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>
